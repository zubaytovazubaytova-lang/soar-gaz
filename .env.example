# SOAR GAZ — server sozlamalari. Serverda nusxa oling:  cp .env.example .env  va to'ldiring.
# .env faylini HECH QACHON git/zip'ga qo'shmang (.gitignore da bor).
# Batafsil: hujjatlar/SERVERGA_QOYISH.md

DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(64))"   (kamida 50 belgi)
DJANGO_SECRET_KEY=BU_YERGA_UZUN_TASODIFIY_KALIT_YOZING
# Aniq domenlar (vergul bilan). '*' production'da server ishga tushmaydi.
DJANGO_HOSTS=soargaz.uz,www.soargaz.uz
# Sayt manzillari (CORS va CSRF uchun), https bilan
DJANGO_CORS=https://soargaz.uz,https://www.soargaz.uz
# To'lovdan keyin mijoz qaytadigan manzil (MAJBURIY)
TOLOV_RETURN_URL=https://soargaz.uz/
# nginx orqasida 1, to'g'ridan-to'g'ri 0, Cloudflare + nginx 2
DJANGO_PROXIES=1

# PostgreSQL (serverda SHART; uchalasi ham berilmasa SQLite ishlaydi)
DB_NOMI=soargaz
DB_FOYDALANUVCHI=soargaz
DB_PAROL=
DB_HOST=localhost
DB_PORT=5432

# Umumiy kesh (ko'p gunicorn worker'da hisobot keshi va IP cheklov uchun)
REDIS_URL=redis://127.0.0.1:6379/1

# SMS: 'konsol' = SMS yuborilmaydi (faqat dev), 'eskiz' = haqiqiy SMS
SMS_PROVAYDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PAROL=
ESKIZ_FROM=4546

# To'lov tizimlari (merchant kabinetidan)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

# create_admin.py uchun (birinchi administrator). ADMIN_PAROL berilmasa admin yaratilmaydi.
ADMIN_TELEFON=+998918332249
ADMIN_PAROL=

# DIQQAT: DJANGO_SINOV_MIJOZ ni serverda HECH QACHON bermang (faqat lokal sinov uchun).

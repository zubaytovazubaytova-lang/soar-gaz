{
  "name": "soar-gaz",
  "version": "1.0.0",
  "private": true,
  "description": "SOAR GAZ — marketing sayti va kabinetlar uchun build vositalari",
  "scripts": {
    "css": "tailwindcss -i ./assets/tailwind.src.css -o ./assets/tailwind.css --minify",
